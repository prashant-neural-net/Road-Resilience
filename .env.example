# Copy this file to .env and adjust the values for your local environment.
# The API reads environment variables from the shell; load .env with your
# preferred shell/tool before starting Uvicorn.

# Path to the trained DeepLabV3+ checkpoint. The default is
# ./deeplabv3plus_road.pth.
ROAD_RESILIENCE_MODEL_PATH=deeplabv3plus_road.pth

# Directory for prediction overlays and intermediate images.
ROAD_RESILIENCE_OUTPUT_DIR=outputs

# auto selects Apple MPS when available, otherwise CPU. Set cpu, mps, or cuda
# explicitly when required by your deployment.
ROAD_RESILIENCE_DEVICE=auto

# Road pixels are retained when the predicted probability is above this value.
ROAD_RESILIENCE_THRESHOLD=0.5
